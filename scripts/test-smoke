  tests/components/pydantic_ai_agent/test_templated_extra_body.py::test_model_settings_with_templated_extra_body_renders_without_mutation \
  tests/components/pydantic_ai_agent/test_templated_extra_body.py::test_model_settings_with_templated_extra_body_rejects_shape_conflicts \
  tests/components/pydantic_ai_agent/test_model_profiles.py::test_resolve_model_profile_reads_provider_owned_profile \
  tests/components/pydantic_ai_agent/test_model_profiles.py::test_run_settings_override_legacy_profile_run_settings \
  tests/components/pydantic_ai_agent/test_model_profiles.py::test_openai_profile_mapping_uses_persisted_capabilities_not_model_name \
