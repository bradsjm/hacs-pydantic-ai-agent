# Provider integration test credentials. Copy to .env and keep .env uncommitted.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
MCP_ECHO_SERVER_URL=https://mcpplaygroundonline.com/mcp-echo-server

# Optional provider integration model matrix controls.
# By default tests run only OPENAI_MODEL. Set OPENAI_TEST_ALL_MODELS=true to
# fetch OPENAI_BASE_URL/models or OPENAI_MODELS_URL and parametrize tests over
# discovered models. OPENAI_MODEL_LIMIT defaults to 5; set 0 for no limit.
OPENAI_TEST_ALL_MODELS=false
OPENAI_MODELS_URL=
OPENAI_MODEL_IDS=
OPENAI_MODEL_INCLUDE=
OPENAI_MODEL_EXCLUDE=
OPENAI_MODEL_LIMIT=5
